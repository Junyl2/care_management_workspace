{
  "name": "care_manager_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "next": "next start",
    "build": "next build",
    "start": "next start",
    "launch": "npm run setup && npm run dev",
    "setup": "npm install react react-dom next && npm install axios react-spinners swiper date-fns framer-motion react-icons swiper react-hot-toast && npm install -D prettier eslint-config-prettier  @types/react && npm install @reduxjs/toolkit react-redux",
    "clean": "rd /s /q node_modules && del package-lock.json && npm cache clean --force && npm run setup",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.11.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.9",
    "lint": "^0.8.19",
    "next": "^15.4.3",
    "react": "^19.1.0",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-spinners": "^0.17.0",
    "start": "^5.1.0",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "15.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
